# ── ربات مدیریت گروه — نمونهٔ پیکربندی ─────────────────────────────
# یک کپی با نام `.env` بسازید و مقدارها را پر کنید.

# توکن ربات از BotFather (فقط برای حالت --run لازم است؛ --check بدون آن کار می‌کند)
BOT_TOKEN=

# آیدی عددی مالک ربات (حساب شخصی شما) — الزامی
OWNER_ID=

# آیدی سودوها (اختیاری، با کاما جدا کنید)
SUDO_IDS=

# دیتابیس (در فاز فعلی SQLite؛ در افق ۲ به PostgreSQL مهاجرت می‌شود)
GMB_DB_URL=sqlite:///data/group-manager.db

# Redis اختیاری (فعلاً درون‌حافظه کش می‌شود؛ برای مقیاس بعدی)
GMB_REDIS_URL=

# زبان پیش‌فرض: fa یا en
GMB_DEFAULT_LANG=fa

# سطح لاگ: DEBUG / INFO / WARNING / ERROR
GMB_LOG_LEVEL=INFO
