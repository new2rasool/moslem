# ═══════════════════════════════════════════════════════════════════════
# group-manager-bot — نمونهٔ متغیرهای محیط / environment sample (FA + EN)
#
# فارسی: کپی کنید → cp .env.example .env   سپس مقادیر واقعی را وارد کنید.
#        بارگذاری خودکار توسط ./run.sh انجام می‌شود (نیازی به export نیست).
# English: copy with → cp .env.example .env  then fill in real values.
#        ./run.sh loads this file automatically (no manual export needed).
# ═══════════════════════════════════════════════════════════════════════

# ── اجباری / required ────────────────────────────────────────────────
# توکن بات از @BotFather / bot token from @BotFather
BOT_TOKEN=123456789:AAExampleToken…

# API ID و API Hash از https://my.telegram.org (فقط برای اجرای زنده لازم است)
# API ID & API Hash from https://my.telegram.org (only needed for --run)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# آیدی عددی مالک ربات / numeric owner id (required for --check too)
OWNER_ID=123456789

# ── اختیاری / optional ───────────────────────────────────────────────
# سودوهای اضافه (با کاما) / extra sudo ids (comma separated)
# SUDO_IDS=111,222

# زبان پیش‌فرض گروه‌های جدید / default language for new groups: fa|en
# GMB_DEFAULT_LANG=fa

# مسیر دیتابیس sqlite / sqlite database location
# GMB_DB_URL=sqlite:///data/group-manager.db

# سطح لاگ / log level: DEBUG|INFO|WARNING|ERROR
# GMB_LOG_LEVEL=INFO
