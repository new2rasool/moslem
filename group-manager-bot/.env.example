# group-manager-bot — نمونهٔ متغیرهای محیط برای اجرای زنده
# کپی کنید:  cp .env.example .env
# و سپس:      set -a; source .env; set +a   (یا هر روش بارگذاری دلخواه)

# توکن بات از @BotFather (اجباری)
BOT_TOKEN=123456789:AAExampleToken…

# API ID / API Hash از https://my.telegram.org (فقط برای --run لازم است)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# آیدی عددی مالک/سودوی ربات (اجباری)
OWNER_ID=123456789

# زبان پیش‌فرض گروه‌های جدید (اختیاری: fa|en)
# DEFAULT_LANG=fa
