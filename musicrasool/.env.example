# Telegram API credentials (https://my.telegram.org -> API development tools)
API_ID=918990
API_HASH=9c9fe04dc2a85e9dd74208335c537f1a

# Bot token from @BotFather
BOT_TOKEN=8053868457:AAGCNZZ65Bz6rJy69cv7hycnEXidPL8tncg

# Telegram numeric IDs of the "developer" (owner) and the "sudo"
# (second-in-command). Send /start to the bot and check the message
# id shown, or use @userinfobot to find your numeric id.
# If you have only one admin, set both to the same id.
OWNER_ID=6173234874
SUDO_ID=6173234874

# Directory where downloaded media files are stored
DOWNLOAD_DIR=downloads

# Language used for the admin panel: fa (فارسی - default, matches the
# original bot) or en (English). Users can switch their own language
# anytime with /language.
DEFAULT_LANG=fa

# Optional: public Melobit API used by the "search" / "autoplay" commands
MELOBIT_API=https://api.melobit.com/v1
