# ============================================================
# MusicRasool - environment configuration
# ============================================================
# Copy this file to `.env` and fill in your OWN values.
# NEVER commit the real `.env` (it is already in .gitignore).
#
# IMPORTANT: every placeholder below is INVALID on purpose, so a bot started
# from an unedited copy fails immediately instead of silently running with
# somebody else's credentials.
#
# The installer (install.sh / install.bat) asks for each value and writes
# this file for you - if you use the installer you never have to edit it.
# ------------------------------------------------------------

# --- Telegram API credentials ---
# Get both from https://my.telegram.org  (API development tools)
API_ID=PUT_YOUR_API_ID_HERE
API_HASH=PUT_YOUR_API_HASH_HERE

# --- Bot token ---
# Get it from @BotFather after creating your bot
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# --- Owner (main admin) ---
# Numeric user ID of the main administrator (get it from @userinfobot)
OWNER_ID=PUT_YOUR_NUMERIC_USER_ID_HERE

# --- Optional: additional sudo users ---
# Comma separated numeric IDs, e.g. SUDO_ID=111111,222222
# The owner is added automatically.
SUDO_ID=

# --- Default language ---
# fa (Persian) or en (English) - users can still switch per account
DEFAULT_LANG=fa

# --- Folder for downloaded media ---
DOWNLOAD_DIR=downloads
